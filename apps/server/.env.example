# Copy to .env (never committed). Server only.

# Phase 1
ANTHROPIC_API_KEY=
# Optional; defaults to claude-haiku-5-5
CHAT_MODEL=
# Shared code people type to use the demo. Optional locally, required on Vercel.
ACCESS_CODE=

# Phase 3
# Google Maps Platform key with the Routes API enabled, for train and bus connections. Required.
GOOGLE_MAPS_API_KEY=
# Ignav key (ignav.com), for flight fares: 1,000 free requests, then paid. Required.
IGNAV_API_KEY=
LITEAPI_API_KEY=
WEEKLY_PAID_QUOTA=10
# Optional; defaults to "trip-canvas-demo"
NOMINATIM_USER_AGENT=
# Optional locally (an in-memory cache is used). On Vercel the Upstash integration sets them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Langfuse project keys (Settings → API Keys); unset means no tracing.
# cloud.langfuse.com is the EU region; use us.cloud.langfuse.com for the US.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Open-Meteo and db.transport.rest need no key.
PORT=8787
