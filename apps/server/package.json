{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev.ts",
    "start": "tsx --env-file-if-exists=.env src/dev.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:hono --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@hono/node-server": "^2.1.6",
    "@upstash/redis": "^1.41.0",
    "ai": "^7.0.162",
    "better-sqlite3": "^13.0.3",
    "catalog": "workspace:*",
    "hono": "^4.13.16",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
